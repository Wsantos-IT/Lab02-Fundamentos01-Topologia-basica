! --- Access & Security Basic Config Switch --- !
hostname SW1
no ip domain-lookup
service password-encryption
!
banner motd # 
========================================
 AVISO: Acceso restringido y monitoreado
========================================
 #
banner exec #
 ------------------------------------------------------------
[ ACCESO CONCEDIDO ]
Dispositivo actual: $(hostname)
Entorno: Eve-NG - Lab Win
------------------------------------------------------------
#
!
enable algorithm-type scrypt secret ciscoenpa55
!
! --- Admin User --- !
username admin privilege 15 algorithm-type scrypt secret ciscoadminpa55
!
! --- Remote Access --- !
ip domain-name winlab
ip ssh version 2
crypto key generate rsa general-keys modulus 2048
!
line vty 0 15
exec-timeout 5 0
logging synchronous
login local
transport input ssh
exit
!
vlan 99
name GESTION_ADMIN
exit
interface vlan 99
description IP_GESTION
ip address 192.168.99.10 255.255.255.0
no shutdown
exit
!
ip default-gateway 192.168.99.1
!
! --- Console ---- !
line con 0
exec-timeout 5 0
logging synchronous
login local
exit


