! --- Access & Security Basic Config Router --- !
hostname R1
no ip domain-lookup
security passwords min-length 14
service password-encryption
!
banner motd #
========================================
 AVISO: Acceso restringido y monitoreado
========================================
#
!
banner exec #
------------------------------------------------------------
[ ACCESO CONCEDIDO ]
Dispositivo actual: $(hostname)
Entorno: Eve-NG - Lab Win
------------------------------------------------------------
#
!
enable algorithm-type scrypt secret ciscoenpa55
!
! --- Admin User --- !
username admin privilege 15 algorithm-type scrypt secret ciscoadminpa55
!
! --- Remote Access --- !
ip domain-name winlab
ip ssh version 2
crypto key generate rsa general-keys modulus 2048
!
line vty 0 4
 exec-timeout 5 0
 logging synchronous
 login local
 transport input ssh
exit
!
! --- Console ---- !
line con 0
 exec-timeout 5 0
 logging synchronous
 login local
exit
